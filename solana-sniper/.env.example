# Copy to .env (chmod 600). Never commit the real file.

RPC_HTTP_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_KEY
RPC_WS_URL=wss://mainnet.helius-rpc.com/?api-key=YOUR_KEY

TELEGRAM_BOT_TOKEN=123456:ABC-your-bot-token
TELEGRAM_CHAT_ID=123456789

POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://sniper:change-me@postgres:5432/sniper

# Optional: higher Jupiter rate limits
JUPITER_API_KEY=

# Only needed for trading.mode: live. Use a dedicated hot wallet holding only
# what the bot may lose. Either a base58 private key...
SOLANA_PRIVATE_KEY=
# ...or the path (inside the container) of a solana-keygen JSON file.
SOLANA_KEYPAIR_PATH=
