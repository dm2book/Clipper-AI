{
  "name": "signal-radar",
  "version": "0.1.0",
  "private": true,
  "description": "Detects new tokens early and reports objective, measurable market signals to Discord. Does not trade and does not predict prices.",
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "node --env-file-if-exists=.env --import tsx src/index.ts",
    "migrate": "node --env-file-if-exists=.env dist/cli/migrate.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "record-fixtures": "node --env-file-if-exists=.env --import tsx scripts/record-fixtures.ts"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0",
    "bs58": "^6.0.0",
    "ioredis": "^6.0.0",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "prom-client": "^15.1.3",
    "ws": "^8.22.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/pg": "^8.23.1",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
