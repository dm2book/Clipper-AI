# Signal Radar — configuration. Copy to `.env` (chmod 600) and fill in.
# Every variable is validated at startup; empty values count as "not set".
# Secrets live only here (or in your secret manager), never in code or git.

# --- Required -----------------------------------------------------------------

# PostgreSQL. Local (npm run dev): localhost. Docker Compose: host "postgres".
DATABASE_URL=postgres://radar:change-me@localhost:5432/radar

# Solana RPC with WebSocket support. A paid provider (Helius, QuickNode, Triton,
# …) is effectively required: public endpoints throttle logsSubscribe and often
# refuse getProgramAccounts (used for holder counts).
SOLANA_RPC_HTTP_URL=https://your-rpc.example/?api-key=YOUR_KEY
SOLANA_RPC_WS_URL=wss://your-rpc.example/?api-key=YOUR_KEY

# --- Notifications --------------------------------------------------------------

# Discord channel webhook (Channel settings → Integrations → Webhooks).
# Unset = dry run: alerts are written to the log instead of Discord.
DISCORD_WEBHOOK_URL=
DISCORD_USERNAME=Signal Radar

# --- Optional services ------------------------------------------------------------

# Redis cache. Unset = in-memory cache (fine for a single instance).
REDIS_URL=
# Docker Compose uses: REDIS_URL=redis://redis:6379

# Password for the Compose PostgreSQL container (must match DATABASE_URL).
POSTGRES_PASSWORD=change-me

# --- Providers ----------------------------------------------------------------------

SOLANA_RPC_REQUESTS_PER_SECOND=10
# Built-in: raydium_amm_v4, raydium_cpmm, pumpswap, pumpfun (pumpfun is very high volume)
DISCOVERY_SOURCES=raydium_amm_v4,raydium_cpmm,pumpswap
# Extra programs as JSON: [{"name":"my_dex","programId":"...","logPatterns":["Instruction: InitPool"]}]
DISCOVERY_CUSTOM_SOURCES=
DISCOVERY_RESOLVER_CONCURRENCY=4

DEXSCREENER_BASE_URL=https://api.dexscreener.com
# Documented limit is 300/min; stay well below it.
DEXSCREENER_REQUESTS_PER_MINUTE=150

RUGCHECK_ENABLED=true
RUGCHECK_BASE_URL=https://api.rugcheck.xyz/v1
RUGCHECK_API_KEY=
# RugCheck does not publish its limits; start conservatively.
RUGCHECK_REQUESTS_PER_MINUTE=30

GOPLUS_ENABLED=true
GOPLUS_BASE_URL=https://api.gopluslabs.io
GOPLUS_ACCESS_TOKEN=
GOPLUS_REQUESTS_PER_MINUTE=20

# How many external safety providers (RugCheck/GoPlus) must answer PASS or WARN.
SAFETY_MIN_EXTERNAL_PASSES=1
# Whether a WARN (e.g. mutable metadata) still counts as "safety checks passed".
SAFETY_ALLOW_WARN=true

# --- Alert rules ----------------------------------------------------------------------

# NEW TOKEN ALERT: age < 10 min, liquidity > $20k, ≥ 50 holders, safety passed
NEW_TOKEN_MAX_AGE_MINUTES=10
NEW_TOKEN_MIN_LIQUIDITY_USD=20000
NEW_TOKEN_MIN_HOLDERS=50

# MOMENTUM ALERT: transparent score (0–100) from volume spike, transaction
# growth, liquidity growth, market-cap change, buy share and holder growth
MOMENTUM_MIN_SCORE=60
MOMENTUM_MIN_ACTIVE_COMPONENTS=3
MOMENTUM_MIN_LIQUIDITY_USD=20000
MOMENTUM_MIN_CONFIDENCE=0.7

ALERT_COOLDOWN_MINUTES=15
ALERT_ESCALATION_POINTS=15
ALERTS_MAX_PER_HOUR=30
MARKET_DATA_MAX_AGE_SECONDS=60
HOLDERS_MAX_AGE_SECONDS=180

# --- Monitoring tiers ---------------------------------------------------------------------

TIER_HOT_MINUTES=15
TIER_WARM_MINUTES=60
ARCHIVE_AFTER_HOURS=6
SNAPSHOT_INTERVAL_HOT_SECONDS=15
SNAPSHOT_INTERVAL_WARM_SECONDS=60
SNAPSHOT_INTERVAL_COOL_SECONDS=300
ENRICH_INTERVAL_HOT_SECONDS=60
ENRICH_INTERVAL_WARM_SECONDS=300
ENRICH_INTERVAL_COOL_SECONDS=1800
SAFETY_RECHECK_HOT_SECONDS=120
SAFETY_RECHECK_WARM_SECONDS=1800
SAFETY_RECHECK_COOL_SECONDS=3600
# Tokens below this liquidity are polled slowly, not enriched, and archived after a while.
LOW_LIQUIDITY_USD=1000
LOW_LIQUIDITY_ARCHIVE_MINUTES=15
UNINDEXED_ARCHIVE_MINUTES=30
ENRICH_CONCURRENCY=4
RETENTION_DAYS=30

# --- Runtime --------------------------------------------------------------------------------

NODE_ENV=production
LOG_LEVEL=info
RUN_MIGRATIONS_ON_START=true
DATABASE_POOL_MAX=10
HEALTH_HOST=0.0.0.0
HEALTH_PORT=8080
SHUTDOWN_TIMEOUT_MS=20000
